# Site
NEXT_PUBLIC_SITE_URL=https://talentbridgehr.online
NEXT_PUBLIC_CONTACT_EMAIL=hello@talentbridgehr.online
NEXT_PUBLIC_WHATSAPP=91XXXXXXXXXX

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login (change these!)
ADMIN_EMAIL=admin@talentbridgehr.online
ADMIN_PASSWORD=change-this-strong-password
ADMIN_SECRET=put-a-long-random-string-here

# Email notifications (Resend.com)
RESEND_API_KEY=
MAIL_FROM=Talent Bridge <notify@talentbridgehr.online>
NOTIFY_TO=hr@talentbridgehr.online

# Spam protection (Cloudflare Turnstile, optional but recommended)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
